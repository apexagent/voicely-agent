      <AnimatedSection>
        <section className="py-20 px-4 bg-black/20">
          <div className="max-w-6xl mx-auto">
            <div className="text-center mb-16">
              <Badge className="mb-4 bg-cyan-600/20 text-cyan-300 border-cyan-500/30">
                Platform Capabilities
              </Badge>
              <h2 className="text-4xl sm:text-5xl font-bold mb-4" style={{ fontFamily: "'Orbitron', sans-serif" }}>
                Enterprise-Ready Features
              </h2>
            </div>

            <div className="grid md:grid-cols-3 gap-6">
              {[
                {
                  icon: Users,
                  title: "Fully Customizable",
                  description: "Brand voice, personality, knowledge base - tailor every agent to your needs"
                },
                {
                  icon: BarChart3,
                  title: "Advanced Analytics",
                  description: "Real-time sentiment analysis, call transcripts, performance metrics"
                },
                {
                  icon: Shield,
                  title: "Enterprise Security",
                  description: "Bank-grade encryption, GDPR/HIPAA compliant, SOC 2 certified"
                },
                {
                  icon: Zap,
                  title: "Lightning Fast",
                  description: "Sub-second response times create natural, human-like conversations"
                },
                {
                  icon: Globe,
                  title: "Multi-Language",
                  description: "Support for 50+ languages with native pronunciation"
                },
                {
                  icon: Building2,
                  title: "API Access",
                  description: "RESTful API and webhooks for seamless integration"
                }
              ].map((feature, i) => (
                <Card key={i} className="bg-black/60 backdrop-blur-xl border-purple-500/30 hover-elevate">
                  <CardContent className="p-6">
                    <feature.icon className="w-12 h-12 text-purple-400 mb-4" />
                    <h3 className="text-xl font-bold text-white mb-2">{feature.title}</h3>
                    <p className="text-gray-400">{feature.description}</p>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>
      </AnimatedSection>

      {/* Token Economy */}
      <AnimatedSection>
        <section className="py-20 px-4">
          <div className="max-w-6xl mx-auto">
            <div className="text-center mb-16">
              <Badge className="mb-4 bg-purple-600/20 text-purple-300 border-purple-500/30">
                $VOICE Token
              </Badge>
              <h2 className="text-4xl sm:text-5xl font-bold mb-4" style={{ fontFamily: "'Orbitron', sans-serif" }}>
                Token Economy
              </h2>
              <p className="text-xl text-gray-400 max-w-3xl mx-auto">
                Platform utility token powering the Voicely ecosystem
              </p>
            </div>

            <div className="grid md:grid-cols-2 gap-8">
              {/* Token Distribution */}
              <Card className="bg-black/60 backdrop-blur-xl border-purple-500/30">
                <CardHeader>
                  <CardTitle className="text-xl">Token Distribution</CardTitle>
                </CardHeader>
                <CardContent>
                  <ResponsiveContainer width="100%" height={300}>
                    <PieChart>
                      <Pie
                        data={tokenDistribution}
                        cx="50%"
                        cy="50%"
                        labelLine={false}
                        label={({ name, value }) => `${name}: ${value}%`}
                        outerRadius={100}
                        fill="#8884d8"
                        dataKey="value"
                      >
                        {tokenDistribution.map((entry, index) => (
                          <Cell key={`cell-${index}`} fill={entry.color} />
                        ))}
                      </Pie>
                      <Tooltip 
                        contentStyle={{ backgroundColor: '#1a1a2e', border: '1px solid #8B5CF6' }}
                        labelStyle={{ color: '#fff' }}
                      />
                    </PieChart>
                  </ResponsiveContainer>
                </CardContent>
              </Card>

              {/* Token Utility */}
              <Card className="bg-black/60 backdrop-blur-xl border-cyan-500/30">
                <CardHeader>
                  <CardTitle className="text-xl">Token Utility</CardTitle>
                </CardHeader>
                <CardContent className="space-y-4">
                  {[
                    { icon: DollarSign, label: "Platform Payments", desc: "Pay for agent usage and premium features" },
                    { icon: TrendingUp, label: "Staking Rewards", desc: "Earn rewards by staking tokens" },
                    { icon: Users, label: "Governance", desc: "Vote on platform developments" },
                    { icon: Sparkles, label: "Premium Access", desc: "Unlock exclusive features and agents" }
                  ].map((utility, i) => (
                    <div key={i} className="flex items-start gap-3 p-3 bg-gradient-to-r from-black/40 to-black/20 rounded-lg border border-cyan-500/20">
                      <utility.icon className="w-5 h-5 text-cyan-400 flex-shrink-0 mt-0.5" />
                      <div>
                        <div className="text-white font-medium">{utility.label}</div>
                        <div className="text-sm text-gray-400">{utility.desc}</div>
                      </div>
                    </div>
                  ))}
                </CardContent>
              </Card>
            </div>
          </div>
        </section>
      </AnimatedSection>

      {/* Investment CTA */}
      <AnimatedSection>
        <section id="contact" className="py-20 px-4 bg-gradient-to-br from-purple-900/20 via-black/40 to-cyan-900/20">
          <div className="max-w-4xl mx-auto">
            <div className="text-center mb-12">
              <Badge className="mb-4 bg-purple-600/20 text-purple-300 border-purple-500/30">
                Join Us
              </Badge>
              <h2 className="text-4xl sm:text-5xl font-bold mb-4" style={{ fontFamily: "'Orbitron', sans-serif" }}>
                Partner with Voicely
              </h2>
              <p className="text-xl text-gray-400">
                Be part of the voice AI revolution. Schedule a call with our team.
              </p>
            </div>

            <Card className="bg-black/60 backdrop-blur-xl border-purple-500/30">
              <CardContent className="p-8">
                <form className="space-y-6" onSubmit={async (e) => {
                  e.preventDefault();
                  setIsSubmitting(true);

                  try {
                    await apiRequest('POST', '/api/waitlist', {
                      name: formData.name,
                      email: formData.email,
                      company: formData.company,
                      message: formData.message,
                      source: 'investor_page'
                    });

                    toast({
                      title: "Request Submitted!",
                      description: "Our team will contact you within 24 hours to discuss investment opportunities.",
                    });

                    // Clear form
                    setFormData({
                      name: "",
                      email: "",
                      company: "",
                      message: ""
                    });
                  } catch (error) {
                    console.error('[INVESTOR-FORM] Submission error:', error);
                    toast({
                      variant: "destructive",
                      title: "Submission Failed",
                      description: "Please try again or contact us directly at invest@voicelyagent.ai",
                    });
                  } finally {
                    setIsSubmitting(false);
                  }
                }}>
                  <div className="grid md:grid-cols-2 gap-6">
                    <div>
                      <label className="block text-sm font-medium text-gray-300 mb-2">
                        Full Name *
                      </label>
                      <Input
                        required
                        placeholder="John Doe"
                        className="bg-black/40 border-purple-500/30 text-white"
                        value={formData.name}
                        onChange={(e) => setFormData({ ...formData, name: e.target.value })}
                        data-testid="input-investor-name"
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-300 mb-2">
                        Email Address *
                      </label>
                      <Input
                        required
                        type="email"
                        placeholder="john@company.com"
                        className="bg-black/40 border-purple-500/30 text-white"
                        value={formData.email}
                        onChange={(e) => setFormData({ ...formData, email: e.target.value })}
                        data-testid="input-investor-email"
                      />
                    </div>
                  </div>

                  <div>
                    <label className="block text-sm font-medium text-gray-300 mb-2">
                      Company / Fund
                    </label>
                    <Input
                      placeholder="Acme Ventures"
                      className="bg-black/40 border-purple-500/30 text-white"
                      value={formData.company}
                      onChange={(e) => setFormData({ ...formData, company: e.target.value })}
                      data-testid="input-investor-company"
                    />
                  </div>

                  <div>
                    <label className="block text-sm font-medium text-gray-300 mb-2">
                      Message
                    </label>
                    <Textarea
                      placeholder="Tell us about your interest in Voicely..."
                      rows={4}
                      className="bg-black/40 border-purple-500/30 text-white resize-none"
                      value={formData.message}
                      onChange={(e) => setFormData({ ...formData, message: e.target.value })}
                      data-testid="input-investor-message"
                    />
                  </div>

                  <Button
                    type="submit"
                    size="lg"
                    disabled={isSubmitting}
                    className="w-full bg-gradient-to-r from-purple-600 to-cyan-600 hover:from-purple-500 hover:to-cyan-500 text-white shadow-lg shadow-purple-500/50"
                    data-testid="button-investor-inquiry"
                  >
                    <Rocket className="w-5 h-5 mr-2" />
                    {isSubmitting ? "Submitting..." : "Schedule Investment Call"}
                  </Button>
                </form>

                <div className="mt-8 pt-8 border-t border-purple-500/20 text-center">
                  <p className="text-gray-400 mb-4">Or reach us directly:</p>
                  <div className="flex flex-col sm:flex-row gap-4 justify-center text-sm">
                    <a href="mailto:invest@voicelyagent.ai" className="text-purple-400 hover:text-purple-300">
                      invest@voicelyagent.ai
                    </a>
                    <span className="hidden sm:inline text-gray-600">•</span>
                    <span className="text-gray-400">San Francisco, CA</span>
                  </div>
                </div>
              </CardContent>
            </Card>
          </div>
        </section>
      </AnimatedSection>

      {/* Footer */}
      <footer className="py-12 px-4 border-t border-purple-500/20">
        <div className="max-w-6xl mx-auto text-center text-gray-500 text-sm">
          <p>© 2025 Voicely Agent. All rights reserved.</p>
          <p className="mt-2">The Future of Voice AI is Here</p>
        </div>
      </footer>
    </div>
  );
}
